# ==============================================================================
# GraphOne / FrontierAtlas Intelligence Pipeline Configuration
# ==============================================================================

# LLM API Keys (Tier 1 -> Tier 2 -> Tier 3 -> Deterministic Fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub API Token (for live star retrieval & higher rate limits)
GITHUB_TOKEN=

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/intelligence_graph.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelligence_graph

# Pipeline Settings
LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=25
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_RETRIES=5
ENABLE_STEALTH_MODE=true
TARGET_SCRAPE_COUNT=1000
